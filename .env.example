# Copy to .env and fill in. Used by docker-compose.yml.

# Database
POSTGRES_PASSWORD=change-me

# Backend JWT (use a long random string)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_VALID_ISSUER=http://localhost:8080/
JWT_VALID_AUDIENCE=SchedulifyServer

# Backend SMTP (Gmail app password)
MAIL_ADDRESS=your-account@gmail.com
MAIL_PASSWORD=your-app-password

# Host port for the backend; keep NEXT_PUBLIC_API_URL in sync
BACKEND_PORT=8080

# Frontend (inlined at build time; browser must be able to reach these URLs)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_NEXT_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
